      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
              "pm.test(\"error.message\", () => pm.expect(pm.response.json().error.message).to.eql(\"Event not found\"));"
            ]
          }
