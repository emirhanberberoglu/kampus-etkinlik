    {
      "name": "16 Yaklaşan etkinlikler",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const events = pm.response.json();",
              "const ms = (s) => { const [g, a, y] = s.split(\"-\").map(Number); return Date.UTC(y, a - 1, g); };",
              "const d = new Date();",
              "const bugun = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());",
              "pm.test(\"yanit dizi ve bos degil\", () => {",
              "  pm.expect(events).to.be.an(\"array\");",
              "  pm.expect(events.length).to.be.at.least(1);",
              "});",
              "pm.test(\"gecmis tarihli etkinlik listede yok\", () => {",
              "  events.forEach((e) => pm.expect(ms(e.date)).to.be.at.least(bugun));",
              "});",
              "pm.test(\"tarihe gore artan sirali\", () => {",
              "  const tarihler = events.map((e) => ms(e.date));",
              "  pm.expect(tarihler).to.eql([...tarihler].sort((a, b) => a - b));",
              "});"
            ]
          }
        }
