{
  "info": {
    "name": "Kampüs API",
    "description": "Kampüs Etkinlikleri REST API (Sprint 7-8). Önce backend klasöründe `npm run seed`, sonra `npm run dev` çalıştır; istekleri sırayla gönder. 3. istek, 2. istekte listeden alınan _id ile çalışır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok ve ogrenci no var\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql(\"ok\");",
              "  pm.expect(body.student).to.eql(\"2416501013\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2 Etkinlik listesi",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const events = pm.response.json();",
              "pm.test(\"seed sonrasi en az 6 kayit, her birinde _id ve createdAt var\", () => {",
              "  pm.expect(events).to.be.an(\"array\");",
              "  pm.expect(events.length).to.be.at.least(6);",
              "  events.forEach((e) => {",
              "    pm.expect(e).to.have.property(\"_id\");",
              "    pm.expect(e).to.have.property(\"createdAt\");",
              "  });",
              "});",
              "// 3. istek bu _id ile calisir (listedeki ilk etkinlik)",
              "if (events.length > 0) pm.collectionVariables.set(\"eventId\", events[0]._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3 Tek etkinlik",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 2. istek henuz gonderilmediyse listeden bir _id al",
              "if (!pm.collectionVariables.get(\"eventId\")) {",
              "  pm.sendRequest(\"http://localhost:3000/events\", (err, res) => {",
              "    if (!err) pm.collectionVariables.set(\"eventId\", res.json()[0]._id);",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"listeden alinan _id ile ayni kayit\", () => {",
              "  pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get(\"eventId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/{{eventId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "{{eventId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4 Olmayan etkinlik (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
              "pm.test(\"error.message\", () => pm.expect(pm.response.json().error.message).to.eql(\"Event not found\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/yok",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "yok"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5 Etkinlik oluştur (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"yeni kayit _id ve createdAt ile doner\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body._id).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(body).to.have.property(\"createdAt\");",
              "  pm.expect(body.title).to.eql(\"Kampüs Kodlama Gecesi\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kampüs Kodlama Gecesi\",\n  \"category\": \"Yarışma\",\n  \"capacity\": 60,\n  \"date\": \"2026-12-26\",\n  \"time\": \"18:00\",\n  \"location\": \"Bilgisayar Laboratuvarı 2\",\n  \"description\": \"Geceyi birlikte kodlayarak geçirelim, sabaha pizza var.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "6 Eksik veri (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
              "pm.test(\"error.message schema dogrulamasindan gelir\", () => {",
              "  const message = pm.response.json().error.message;",
              "  pm.expect(message).to.include(\"validation failed\");",
              "  pm.expect(message).to.include(\"required\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sadece başlık\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "eventId",
      "value": ""
    }
  ]
}
