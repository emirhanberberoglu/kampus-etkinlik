    {
      "name": "5 Etkinlik oluştur (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"yeni kayit id ile doner\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(body.title).to.eql(\"Kampüs Kodlama Gecesi\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kampüs Kodlama Gecesi\",\n  \"category\": \"Yarışma\",\n  \"capacity\": 60,\n  \"date\": \"2026-12-26\",\n  \"time\": \"18:00\",\n  \"location\": \"Bilgisayar Laboratuvarı 2\",\n  \"description\": \"Geceyi birlikte kodlayarak geçirelim, sabaha pizza var.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
