              "  pm.sendRequest({",
              "    url: \"http://localhost:3000/events\", method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: { mode: \"raw\", raw: JSON.stringify({ title: \"Kampüs Kodlama Gecesi\", category: \"Yarışma\", date: \"26-12-2026\" }) }",
              "  }, (err, res) => {",
              "    if (!err) pm.collectionVariables.set(\"newEventId\", res.json()._id);",
              "  });",
              "}"
            ]
          }
        },
